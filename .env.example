# Server
PORT=3000
NODE_ENV=development

# Redis Cache
REDIS_URL=redis://localhost:6379
CACHE_PREFIX=bom:warning:
CACHE_DEFAULT_TTL=3600

# FTP Pool
FTP_HOST=ftp.bom.gov.au
FTP_PATH=/anon/gen/fwo/
FTP_POOL_MIN=2
FTP_POOL_MAX=10
FTP_ACQUIRE_TIMEOUT=30000
FTP_IDLE_TIMEOUT=30000
FTP_VERBOSE=false

# Logging
LOG_LEVEL=info
